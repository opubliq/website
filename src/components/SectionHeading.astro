---
interface Props {
  title: string;
  kicker?: string;
  lead?: string;
  id?: string;
}
const { title, kicker, lead, id } = Astro.props;
---
<div class="max-w-2xl">
  {kicker && <p class="kicker mb-3">{kicker}</p>}
  <h2 id={id} class="text-3xl font-bold md:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-lg leading-relaxed text-muted">{lead}</p>}
</div>
