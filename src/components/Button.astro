---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'onDark';
  size?: 'md' | 'lg';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', arrow = false, class: className = '' } = Astro.props;

const variants = {
  primary: 'bg-brand-soft text-ink hover:bg-ink hover:text-white',
  secondary: 'bg-ink text-white hover:bg-brand-strong',
  onDark: 'border border-white/30 text-white hover:border-brand-soft hover:text-brand-soft',
};
const sizes = { md: 'px-5 py-2.5 text-sm', lg: 'px-6 py-3.5 text-base' };
---
<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-button font-semibold transition-colors duration-150',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
  {arrow && <Icon name="arrowRight" class="size-4" />}
</a>
