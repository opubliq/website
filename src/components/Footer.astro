---
import { Image } from 'astro:assets';
import logo from '../assets/logos/Opubliq_V2_couleur-transparent.png';
import Icon from './Icon.astro';
import company from '../data/company.json';
import { colon, getCopy, navKeys, path, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getCopy(lang);
const year = new Date().getFullYear();
const social = [
  { key: 'linkedin', href: company.links.linkedin, label: t.ui.social.linkedin },
  { key: 'github', href: company.links.github, label: t.ui.social.github },
  { key: 'scholar', href: company.links.scholar, label: t.ui.social.scholar },
] as const;
---
<footer class="bg-ink text-white">
  <div class="container-page grid gap-10 py-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <Image src={logo} alt="Opubliq" height={40} densities={[1, 2]} class="h-10 w-auto" />
      <p class="mt-4 max-w-xs text-sm text-on-dark-muted">{t.ui.footer.tagline}</p>
      <ul class="mt-6 flex gap-2">
        {social.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-10 items-center justify-center rounded-full border border-white/20 text-white/85 transition-colors hover:border-brand-soft hover:text-brand-soft"
            >
              <Icon name={s.key} class="size-[18px]" label={`${s.label} ${t.ui.externalLink}`} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-4">
      <h2 class="text-xs font-semibold uppercase tracking-widest text-brand-soft">{t.ui.footer.companyHeading}</h2>
      <address class="mt-4 space-y-1 text-sm not-italic leading-relaxed text-white/90">
        <p class="font-semibold text-white">{company.legalName}</p>
        {t.company.addressLines.map((line) => <p>{line}</p>)}
        <p class="pt-2">{t.ui.footer.neqLabel}{colon(lang)}{company.neq}</p>
        <p>{t.ui.footer.founderLabel}{colon(lang)}{company.founder}</p>
        <p class="pt-2">
          <a class="hover:text-brand-soft" href={`mailto:${company.email}`}>{company.email}</a><br />
          <a class="hover:text-brand-soft" href={`tel:${company.phoneE164}`}>{company.phoneDisplay}</a>
        </p>
      </address>
    </div>

    <nav class="md:col-span-3" aria-label={t.ui.footer.navHeading}>
      <h2 class="text-xs font-semibold uppercase tracking-widest text-brand-soft">{t.ui.footer.navHeading}</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="text-white/90 hover:text-brand-soft" href={path('home', lang)}>{t.ui.nav.home}</a></li>
        {navKeys.map((key) => (
          <li><a class="text-white/90 hover:text-brand-soft" href={path(key, lang)}>{t.ui.nav[key]}</a></li>
        ))}
        <li><a class="text-white/90 hover:text-brand-soft" href={path('privacy', lang)}>{t.ui.footer.privacy}</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-on-dark-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {company.legalName} {t.ui.footer.rights}</p>
      <p>{t.company.location} · {t.ui.footer.neqLabel} {company.neq}</p>
    </div>
  </div>
</footer>
