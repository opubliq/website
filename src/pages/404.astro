---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { getCopy, path } from '../i18n';

// Single bilingual 404 (GitHub Pages serves /404.html for every missing path).
const fr = getCopy('fr').notFound;
const en = getCopy('en').notFound;
---
<BaseLayout lang="fr" title={`${fr.title} | Opubliq`} description={fr.text} noindex>
  <section class="py-24 md:py-32">
    <div class="container-page grid gap-12 md:grid-cols-2">
      <div>
        <p class="kicker">404</p>
        <h1 class="mt-3 text-4xl font-bold">{fr.title}</h1>
        <p class="mt-4 text-lg text-muted">{fr.text}</p>
        <div class="mt-8"><Button href={path('home', 'fr')} arrow>{fr.home}</Button></div>
      </div>
      <div lang="en-CA">
        <p class="kicker">404</p>
        <h2 class="mt-3 text-4xl font-bold">{en.title}</h2>
        <p class="mt-4 text-lg text-muted">{en.text}</p>
        <div class="mt-8"><Button href={path('home', 'en')} arrow>{en.home}</Button></div>
      </div>
    </div>
  </section>
</BaseLayout>
