---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { getCopy, path, type Lang } from '../i18n';
import type { IconName } from '../components/icons';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getCopy(lang);
const s = t.services;
---
<BaseLayout lang={lang} routeKey="services" title={s.meta.title} description={s.meta.description}>
  <PageHero title={s.title} lead={s.lead} />

  <section class="py-16 md:py-20">
    <div class="container-page grid gap-6 md:grid-cols-2">
      {s.list.map((service) => (
        <article class="card flex flex-col p-7 md:p-8">
          <div class="flex items-center gap-4">
            <span class="inline-flex size-12 shrink-0 items-center justify-center rounded-xl bg-ink text-brand-soft">
              <Icon name={service.icon as IconName} class="size-6" />
            </span>
            <h2 class="text-xl font-bold leading-snug md:text-2xl">{service.title}</h2>
          </div>
          <ul class="mt-6 divide-y divide-line">
            {service.items.map((item) => (
              <li class="flex gap-3 py-4 first:pt-0 last:pb-0">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-brand" />
                <div>
                  <h3 class="text-base font-semibold">{item.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-muted">{item.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-surface-alt py-16 md:py-24" aria-labelledby="why-title">
    <div class="container-page">
      <SectionHeading id="why-title" title={s.why.title} />
      <div class="mt-10 grid gap-x-12 gap-y-10 md:grid-cols-2">
        {s.why.items.map((item, i) => (
          <div class="border-t-2 border-brand-soft pt-5">
            <p class="font-display text-sm font-bold text-brand-strong">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 text-xl font-bold">{item.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner title={t.cta.readyTitle} text={t.cta.readyText} buttonLabel={t.cta.consultation} href={path('contact', lang)} />
</BaseLayout>
