---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import hubert from '../assets/people/hubert.png';
import alexandre from '../assets/people/alex.png';
import nicolas from '../assets/people/nicolas.jpg';
import PersonContact from '../components/PersonContact.astro';
import { getCopy, path, personPath, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getCopy(lang);
const team = t.team;

// Photo per person id (see "id" in src/content/copy/<lang>.json).
const photos: Record<string, ImageMetadata> = { hubert, alexandre, nicolas };
---
<BaseLayout lang={lang} routeKey="team" title={team.meta.title} description={team.meta.description}>
  <PageHero title={team.title} lead={team.lead} />

  <section class="py-16 md:py-20">
    <div class="container-page flex flex-col gap-10">
      {team.people.map((person) => (
        <article class="card flex flex-col gap-6 p-7 md:flex-row md:gap-10 md:p-10">
          <Image
            src={photos[person.id]}
            alt={person.photoAlt}
            widths={[200, 400]}
            sizes="200px"
            class="aspect-[4/5] w-36 shrink-0 self-start rounded-xl object-cover object-top md:w-44"
          />
          <div class="flex flex-1 flex-col">
            <h2 class="text-3xl font-bold">{person.name}</h2>
            <p class="mt-1 text-base font-semibold text-brand-strong">{person.role}</p>
            <div class="mt-4 space-y-4 text-lg leading-relaxed text-muted">
              {person.bio.map((para) => <p>{para}</p>)}
            </div>
            <div class="mt-auto pt-6">
              <a href={personPath(person.slug, lang)} class="mb-5 inline-flex items-center gap-2 text-base font-semibold text-brand-strong hover:underline">
                {team.cv.link}<span aria-hidden="true">→</span><span class="sr-only"> — {person.name}</span>
              </a>
              <div><PersonContact lang={lang} person={person} /></div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <CtaBanner title={t.cta.readyTitle} text={t.cta.readyText} buttonLabel={t.cta.letsTalk} href={path('contact', lang)} />
</BaseLayout>
