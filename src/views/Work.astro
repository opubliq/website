---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Testimonial from '../components/Testimonial.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { getCopy, path, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getCopy(lang);
const w = t.work;
const cs = w.caseStudy;
const [introBefore, introAfter] = cs.intro.split('{client}');
---
<BaseLayout lang={lang} routeKey="work" title={w.meta.title} description={w.meta.description}>
  <PageHero title={w.title} lead={w.lead} />

  <!-- Case study -->
  <section class="py-16 md:py-20" aria-labelledby="case-title">
    <div class="container-page grid items-start gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <p class="kicker mb-3">{cs.label}</p>
        <h2 id="case-title" class="text-3xl font-bold md:text-4xl">{cs.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          {introBefore}<a class="link" href={cs.clientUrl} target="_blank" rel="noopener noreferrer">{cs.client}</a>{introAfter}
        </p>
        <p class="mt-6 font-semibold text-ink">{cs.mandateLabel}</p>
        <ul class="mt-3 space-y-3">
          {cs.mandate.map((m) => (
            <li class="flex gap-3">
              <Icon name="check" class="mt-1 size-4 shrink-0 text-brand" />
              <span>{m}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-2">
        <Testimonial quote={cs.quote} author={cs.quoteAuthor} role={cs.quoteRole} note={cs.quoteNote} lang={lang} />
      </div>
    </div>
  </section>

  <!-- Research -->
  <section class="bg-surface-alt py-16 md:py-24" aria-labelledby="research-title">
    <div class="container-page">
      <SectionHeading id="research-title" title={w.researchTitle} />
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {w.research.map((group) => (
          <article class="card p-7">
            <h3 class="text-xl font-bold leading-snug">{group.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{group.intro}</p>
            <ul class="mt-5 space-y-4">
              {group.items.map((item) => (
                <li class="border-l-2 border-brand-soft pl-4">
                  <p class="text-xs font-semibold uppercase tracking-wider text-brand-strong">{item.date}</p>
                  <p class="mt-1 text-sm text-text">{item.text}</p>
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="link mt-1 inline-flex items-start gap-1.5 text-sm">
                    <span>{item.linkTitle}</span>
                    <Icon name="external" class="mt-0.5 size-3.5 shrink-0" label={t.ui.externalLink} />
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner title={w.cta.title} text={w.cta.text} buttonLabel={t.cta.consultation} href={path('contact', lang)} />
</BaseLayout>
